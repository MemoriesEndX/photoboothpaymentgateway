# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_USER=photobooth
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=photobooth_db
DATABASE_URL="postgresql://photobooth:replace_with_strong_password@db:5432/photobooth_db?schema=public"

# ==============================================================================
# Application Ports & Host
# ==============================================================================
# Host port mapping (default 3001 to prevent conflict if 3000 is used on host)
APP_PORT=3001

# ==============================================================================
# NextAuth / JWT Authentication
# ==============================================================================
# Eventual production URL: https://photobooth.memoriesend.my.id
NEXTAUTH_URL="https://photobooth.memoriesend.my.id"
NEXTAUTH_SECRET=generate_with_openssl_rand_base64_32
JWT_SECRET=generate_with_openssl_rand_base64_32

# ==============================================================================
# Public Base URL (Used for QR Code generation and sharing links)
# ==============================================================================
NEXT_PUBLIC_BASE_URL="https://photobooth.memoriesend.my.id"

# ==============================================================================
# Storage Configuration
# ==============================================================================
STORAGE_MODE=local

# Optional AWS S3 Configuration (if upgrading from local storage in the future)
# S3_REGION=ap-southeast-1
# S3_BUCKET=your-s3-bucket-name
# S3_ACCESS_KEY=your-s3-access-key
# S3_SECRET_KEY=your-s3-secret-key

# ==============================================================================
# Resend Email Integration
# ==============================================================================
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL="Photo Booth <noreply@yourdomain.com>"
SUPPORT_EMAIL=support@memoriesend.my.id
